# Google AI Studio API-Key (Gemini + Gemma via litellm, Search Grounding, Antigravity SDK)
GEMINI_API_KEY=dein-key-hier

# Optional: Pfad zum eigenen Vault (Standard: der mitgelieferte Demo-Vault)
